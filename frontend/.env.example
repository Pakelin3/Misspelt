# Plantilla de variables de entorno del frontend.
#
# REGLA: aqui solo van valores PUBLICOS. Vite reemplaza cada `import.meta.env.VITE_*`
# por su valor literal dentro del JS que descarga el navegador, asi que cualquier
# secreto con prefijo VITE_ queda publicado para todo el mundo.
#
# Las claves de servicios (ElevenLabs, Gemini, GitHub, Resend) van en backend/.env
# y el frontend las consume a traves de /game/tts/, /game/stt/, /game/oracle/ y
# /dictionary/suggest-word/.

# URL base de la API de Django, incluyendo /api
VITE_BACKEND_URL_API=https://127.0.0.1:8000/api

# Client ID de Google OAuth. Publico por diseno; el client SECRET no va aqui.
VITE_CLIENT_ID_GOOGLE=
